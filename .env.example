# Host and LAN features are off by default. Set to 1 only for a local Mac installation.
VANTAGE_LOCAL=0
# Hosted deployments: exact browser origin, including port when needed. Leave unset locally.
# VANTAGE_ORIGIN=https://vantage.example.com

# Optional. A YouTube Data API v3 key adds live streams to the City map (README, "Optional keys").
VANTAGE_YOUTUBE_KEY=
# Optional. A non-commercial Flickr API key adds recent photos to the City map (README, "Optional keys").
VANTAGE_FLICKR_KEY=
# Optional. A free Windy.com Webcams API key adds webcams worldwide to Cameras, the City map and Around me (README, "Optional keys").
VANTAGE_WINDY_WEBCAM_KEY=
# Optional. A free Belgian Mobility developer key raises the small anonymous allowance for live STIB and TEC data (README, "Optional keys").
VANTAGE_BELGIAN_MOBILITY_KEY=
# Optional. A web address or email address of yours; Planespotters.net needs one before it serves airframe photos (README, "Optional keys").
VANTAGE_CONTACT=
# Optional. Traffic API + Search + EV Charging Stations Availability access. See README.
VANTAGE_TOMTOM_KEY=
# Optional. Cloudflare token with Account > Radar > Read permission.
VANTAGE_CLOUDFLARE_TOKEN=
# Optional. AIS Stream API key for ship reports beyond Finland and Norway.
VANTAGE_AISSTREAM_KEY=
# Optional. Your amateur radio callsign; APRS-IS uses receive-only pass -1.
VANTAGE_APRS_CALLSIGN=
# Optional. Drone Remote ID feed URL. Unset, VANTAGE reads an Orecchino receiver at
# http://orecchino.local/data/remoteid.json. For dump3411, use its --serve URL.
# Example: http://receiver.local:8754/data/remoteid.json
VANTAGE_DRONE_RECEIVER_URL=
